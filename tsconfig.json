{
  // Node 24 runs the .ts files directly (type stripping); tsc only type-checks.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // public/ is browser JS, not type-checked; allowJs lets tests import public/selection.js.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "test", "dev"]
}
