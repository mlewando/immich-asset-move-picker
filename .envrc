# Isolate the gh CLI to the personal `mlewando` account for THIS repo only.
#
# Why an env token and not just GH_CONFIG_DIR: gh stores its OAuth token in the macOS
# login keychain, which is ONE shared store for the whole OS user. GH_CONFIG_DIR only
# separates the config *files* (which account is "active"), not the token store — so the
# last `gh auth login`/`switch` wins across every config dir. A GH_TOKEN env var overrides
# the keychain entirely and takes top precedence, and direnv scopes it to this repo only:
# here => mlewando (the token below); everywhere else => the global keychain (mlewando-cp).
#
# Setup (one-time): create a PAT on the PERSONAL github.com account, then:
#   mkdir -p ~/.config/gh-tokens
#   (paste token) > ~/.config/gh-tokens/mlewando   &&   chmod 600 ~/.config/gh-tokens/mlewando
export GH_CONFIG_DIR="${PWD}/.config/gh-priv"   # keep config/state out of the company config

gh_token_file="${HOME}/.config/gh-tokens/mlewando"
if [ -r "${gh_token_file}" ]; then
  export GH_TOKEN="$(cat "${gh_token_file}")"
else
  echo "direnv WARN: ${gh_token_file} missing — gh will fall back to the SHARED keychain (not isolated)" >&2
fi
unset gh_token_file
